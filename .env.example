# Used by docker compose (copy to .env and fill in). Never commit the real file.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
FRONTEND_PORT=8081
BACKEND_PORT=8080

# Optional: forward contact-form messages by email over Gmail SMTP (use an app password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
