# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/foodshop
# Port the API listens on (the frontend dev proxy expects 8080 unless you change VITE_PROXY_TARGET)
PORT=8080
# Required: long random string used to sign login tokens
JWT_SECRET=REPLACE_ME
JWT_EXPIRE=1d
# Comma-separated browser origins allowed by CORS (unset = any origin)
CORS_ORIGIN=
HOST=0.0.0.0
# Where uploaded dish images are stored (default: Backend/uploads)
UPLOAD_DIR=
# Rate limits (optional)
RATE_LIMIT_PER_MINUTE=600
LOGIN_MAX_FAILURES=10

# Optional: forward contact-form messages by email over Gmail SMTP.
# Create an app password for the sending account (never use the normal account password).
# Leave blank to only keep messages in the admin inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where those messages are delivered
CONTACT_TO=
